# Copy to .env and fill in. .env is never committed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Local Postgres from docker-compose.yml (these are the defaults if unset)
DATABASE_URL=postgresql+psycopg://morehere:morehere@localhost:5432/morehere
TEST_DATABASE_URL=postgresql+psycopg://morehere:morehere@localhost:5432/morehere_test

# Overpass API endpoint for OpenStreetMap ingestion (default shown)
OVERPASS_URL=https://overpass-api.de/api/interpreter
